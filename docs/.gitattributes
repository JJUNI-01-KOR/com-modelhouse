# 줄바꿈 자동 처리
* text=auto

# 코드
*.cs        text diff=csharp
*.md        text

# Unity YAML (Force Text 설정이어야 텍스트로 저장됨)
*.unity     text
*.prefab    text
*.asset     text
*.meta      text
*.mat       text
*.anim      text
*.controller text
*.physicMaterial text
*.inputactions text

# 바이너리 (diff·병합하지 않음)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.ttf   binary
*.otf   binary

# 50MB가 넘는 파일이 생기면 Git LFS를 켜고 아래 주석을 푼다
# (GitHub는 100MB 넘는 파일을 거부한다)
